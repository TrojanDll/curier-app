<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        BASE_URL вводится в runtime через экран «Подключение к серверу»,
        поэтому разрешаем cleartext для всех адресов. В self-hosted-сценарии
        backend обычно запущен в локальной сети (HTTP без сертификата).
        TODO §7.9: для release-сборки добавить override с более строгими правилами.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
