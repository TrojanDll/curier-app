# Copy this file to .env and adjust values for your environment.

# --- App ---
NODE_ENV=development
PORT=8081
LOG_LEVEL=debug

# --- Database ---
# For local dev with docker-compose.dev.yml use the values below as-is.
DATABASE_URL=postgresql://curier:curier_dev@localhost:5432/curier?schema=public

# --- Auth ---
# Generate via: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- First admin auto-seed (Stage 2.11) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# --- Photos (Stage 2.7 / 2.10) ---
PHOTO_UPLOAD_DIR=./uploads
PHOTO_TTL_DAYS=30
