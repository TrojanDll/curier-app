# Copy this file to .env and adjust values for your environment.

# --- App ---
NODE_ENV=development
PORT=8081
LOG_LEVEL=debug

# --- Database ---
# For local dev with docker-compose.dev.yml use the values below as-is.
DATABASE_URL=postgresql://curier:curier_dev@localhost:5433/curier?schema=public

# --- Auth ---
# Generate via: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- First admin auto-seed (Stage 2.11) ---
# Used only when the `admins` table is empty on bootstrap. After the first
# admin is created these values are ignored — change credentials via the
# admin UI / password reset flow.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
# Optional. Falls back to "Initial Admin" if blank.
INITIAL_ADMIN_FULL_NAME=Initial Admin

# --- Photos (Stage 2.7 / 2.10) ---
PHOTO_UPLOAD_DIR=./uploads
PHOTO_TTL_DAYS=30
PHOTO_MAX_SIZE_MB=10
