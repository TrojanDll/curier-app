# Copy to `.env` (next to docker-compose.yml) and fill in real secrets.
# Defaults are listed for tunables that have safe fallbacks in the
# compose file — leave them commented to use those.
#
# This file ships with the repo. The real `.env` is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=curier
DB_PASSWORD=CHANGE_ME_db
DB_NAME=curier

# ─── Backend auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_64_chars
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ─── First admin (auto-seed, Stage 2.11) ─────────────────────────────────────
# Backend seeds this account on first boot if the admins table is empty.
# Change the password from the UI right after first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_admin
# INITIAL_ADMIN_FULL_NAME=Initial Admin

# ─── Photos ──────────────────────────────────────────────────────────────────
# Runtime TTL is editable from the admin UI; this only seeds the initial row.
# PHOTO_TTL_DAYS=30
# PHOTO_MAX_SIZE_MB=10

# ─── Backups ─────────────────────────────────────────────────────────────────
# Backup archives live in the `backups` volume (/app/backups). Max size of a
# single ZIP accepted by the "Импортировать" button (anti-DoS ceiling, MB).
# BACKUP_MAX_IMPORT_MB=2048

# ─── Logging ─────────────────────────────────────────────────────────────────
# pino levels: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info

# ─── Host ports (override if 8081 / 3000 are taken) ──────────────────────────
# BACKEND_PORT=8081
# ADMIN_PORT=3000

# ─── Auth cookies ────────────────────────────────────────────────────────────
# Set to 1 if you serve admin over plain HTTP (no TLS in front). Otherwise
# browsers drop the auth cookie because of its `Secure` flag and login
# silently fails. Leave at 0 once HTTPS is in place.
# INSECURE_COOKIES=1

# ─── Realtime (Socket.IO) ────────────────────────────────────────────────────
# Public URL where the browser will open WebSocket to backend. The BFF does
# NOT proxy WS, so this MUST be reachable from end-user network. Typically
# the same host:port as direct backend access. Leave blank only for `npm
# run dev` on localhost. Example: http://109.73.203.142:8081
# BACKEND_REALTIME_URL=http://109.73.203.142:8081
