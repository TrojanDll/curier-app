# Copy to `android/keystore.properties` and fill with your real values.
# This file is committed; the real `keystore.properties` is gitignored.
#
# `storeFile` is resolved by Gradle via `rootProject.file(...)`. The Gradle
# rootProject is `/android/` (this directory), NOT the git repo root, so the
# path here is relative to `/android/`. The actual `.jks` is gitignored by
# `/android/**/*.jks` — keep it inside `/android/` (e.g. /android/release.jks).
#
# See docs/android-release-build.md for end-to-end instructions
# (keytool command, signing scheme, troubleshooting).

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=curier-release
keyPassword=CHANGE_ME
