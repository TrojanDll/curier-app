# Claude Code local worktrees + personal settings
.claude/worktrees/
.claude/settings.local.json

# Local scratch (data-seeding scripts etc.)
.seed_tmp/

# Real env files with secrets — only *.env.example is tracked
**/.env

# Playwright MCP scratch (snapshots, console logs)
.playwright-mcp/

# Release signing (Stage 4.6 / §7.9)
# keystore.properties holds the alias + passwords; *.jks / *.keystore are the
# actual signing keys. Both stay out of the repo — see docs/android-release-build.md.
/android/keystore.properties
/android/**/*.jks
/android/**/*.keystore

# Docker compose secrets (Stage 14.5.3+)
/docker/.env
